# spacefin-frontend.service —— 前端驾驶舱（S5，端口 8500）
# 之前用 nohup 裸跑：会话退出即丢进程，已发生一次前端掉线。
# 托管到用户级 systemd 后：开机（linger）/崩溃/被杀都由 systemd 拉起。
#
# 安装（用户级，推荐）：
#   1) mkdir -p ~/.config/spacefin ~/.config/systemd/user
#   2) 写 ~/.config/spacefin/frontend.env（勿加引号，systemd 会把引号当值的一部分）：
#        SPACEFIN_REPO_DIR=/opt/spacefin/SpaceFin-Agent   # 按部署机实际仓库路径调整
#        SPACEFIN_FRONTEND_VENV=/opt/spacefin/SpaceFin-Agent/tools/orchestrator/.venv
#   3) cp deploy/systemd/spacefin-frontend.service ~/.config/systemd/user/
#   4) systemctl --user daemon-reload && systemctl --user enable --now spacefin-frontend
#   5) 无人登录也要常驻：sudo loginctl enable-linger $USER（linger 打开后重启宿主也会自动拉起）
# 验证：curl -s -o /dev/null -w '%{http_code}' http://localhost:8500/   # 期望 200
# 前置：MySQL/Redis 容器已启动；.env 含前端所需数据库配置。
#
# 仓库路径经 EnvironmentFile 注入，不把本机绝对路径硬编码进仓库（模式同 spacefin-cdc.service）。

[Unit]
Description=SpaceFin frontend dashboard (S5, port 8500)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/spacefin/frontend.env
# ExecStart 的可执行文件不能直接用变量，故用 sh -c 展开 EnvironmentFile 里的路径，
# 先 cd 到仓库根再 exec python，保证相对导入与 tools/ 下模块互相引用时工作目录正确。
ExecStart=/bin/sh -c 'cd "$SPACEFIN_REPO_DIR" && exec "$SPACEFIN_FRONTEND_VENV/bin/python" tools/frontend/app.py'
Restart=always
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=spacefin-frontend

[Install]
WantedBy=default.target
