# ==============================================================================
# SpaceFin · Airflow 容器化栈环境变量模板（占位值，勿写真实凭据）
# ------------------------------------------------------------------------------
# 用法：cp .env.example .env && vi .env
# 注意：仓库根 .gitignore 已忽略 .env / .env.*（仅放行 .env.example），
#       但仍请自查 `git status`，不要提交填好的 .env。
# ==============================================================================

# ---- 容器运行身份（必须等于宿主当前用户 uid，否则 logs/ 目录会写不进去）----
# 生成：echo "AIRFLOW_UID=$(id -u)"
AIRFLOW_UID=50000

# ---- Postgres 元数据库 ----
POSTGRES_USER=airflow
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=airflow

# ---- Airflow 密钥（必填，勿留占位）----
# Fernet（加密 Connection/Variable）：
#   python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=CHANGE_ME_fernet_key
# Web session 签名密钥：openssl rand -hex 32
AIRFLOW__WEBSERVER__SECRET_KEY=CHANGE_ME_webserver_secret_key

# ---- 初始管理员账号（airflow-init 创建）----
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=CHANGE_ME_admin_password
_AIRFLOW_WWW_USER_EMAIL=admin@example.com

# ---- 宿主接线 ----
# Web UI 暴露端口
AIRFLOW_WEB_PORT=8080
# SpaceFin 仓库根在宿主上的绝对路径（挂到容器 /opt/spacefin）。
# ⚠️ 留空即用本文件上级目录（= 仓库根），这是默认且正确的选择；只有把 airflow/ 挪出仓库时才需填。
#    切勿随手填一个不存在的路径：dockerd 会自动创建空目录并挂进去，compose config 不报错，
#    但所有 Bash 任务会静默找不到脚本。
SPACEFIN_REPO_ROOT=
TZ=Asia/Shanghai
