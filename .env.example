# ==============================================================================
# SpaceFin Agent · 本地开发环境变量模板
# ------------------------------------------------------------------------------
# 用法：cp .env.example .env  后按需修改。
# 注意：.env 已被 .gitignore 忽略，切勿提交真实密码；此处仅为本地开发示例值。
# ==============================================================================

# MySQL 业务源库
MYSQL_ROOT_PASSWORD=spacefin_dev_only
MYSQL_DATABASE=spacefin
MYSQL_PORT=3306

# ------------------------------------------------------------------------------
# Superset BI 看板（L5 投产加固）
# ------------------------------------------------------------------------------
# 元数据库管理员密码（PostgreSQL，superset-metadata-db service）；生产务必改强值。
SUPERSET_PG_PASSWORD=superset_dev_only
# Superset 元数据库仅绑 127.0.0.1 的宿主机端口（默认 5433→容器 5432），按需改。
SUPERSET_PG_PORT=5433

# Superset 登录口令（create-admin / setup_superset.py 共用）；生产务必改强值，
# 与 SF_PWD_* 同口径的强口令治理。
SUPERSET_PASSWORD=superset_dev_only

# Superset Flask SECRET_KEY：演示用固定 dev 值避免重启会话失效；
# 生产【必须】注入强随机值（如 openssl rand -hex 32），否则存在会话伪造风险。
# 示例：SUPERSET_SECRET_KEY=$(openssl rand -hex 32)
SUPERSET_SECRET_KEY=spacefin-superset-dev-secret-fixed

# ------------------------------------------------------------------------------
# I-05 贷后保全预警真实推送（postloan_http 驱动，可选）
# ------------------------------------------------------------------------------
# 配置 SPACEFIN_POSTLOAN_WEBHOOK_URL 后，tools/alerting/main.py 自动启用真实贷后
# 系统 HTTP 推送（无需改命令）；未配置时仅落站内告警表 + 推送日志，闭环不接通。
# 接收端应以 Idempotency-Key（"{loan_id}:{alert_date}"）去重，避免重试产生重复工单。
# SPACEFIN_POSTLOAN_WEBHOOK_URL=https://postloan.internal/api/v1/ltv-alerts
# SPACEFIN_POSTLOAN_WEBHOOK_TOKEN=replace-with-shared-secret
# SPACEFIN_POSTLOAN_TIMEOUT=10

# ------------------------------------------------------------------------------
# 工作流加固（G1 失败派发 / G2 采集质量闸门 / G3 严格排空）
# ------------------------------------------------------------------------------
# 失败派发：Airflow 任意节点失败时，on_failure_callback 向 Slack incoming-webhook
# 推送告警，并 @ 四类角色（产品/开发/QA/审核）。默认【关】，仅在配置了 Webhook 后生效。
# 通知文案中 ROLE_DISTRIBUTION = "产品/开发/QA/审核"，mentions 留空则只文字说明不 @ 人。
# SPACEFIN_ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ
# SPACEFIN_ALERT_MENTIONS=<@U0XXXX> <@U0YYYY>   # 可选：@产品/开发/QA/审核 的具体成员

# G2 采集质量闸门（crawl_quality_gate.py）：统计当日新增爬取行数
#   first_seen_date = 业务日 的行数。低于软下限→告警放行；低于硬下限→默认告警放行。
# 硬下限（默认 50 行）、软下限（默认 200 行）。
# SPACEFIN_MIN_CRAWL_ROWS=50
# SPACEFIN_MIN_CRAWL_ROWS_WARN=200

# 严格模式默认【关】。开启后：G2 低于硬下限会拦停（exit 2）链路在 ETL 前；
# G3 drain_workers 排空遇非预期残工则抛错而非尽力告警。需手动开，避免误杀整条日终。
# SPACEFIN_CRAWL_GATE_STRICT=0
# SPACEFIN_DRAIN_STRICT=0
